# ---- Required ----
ANTHROPIC_API_KEY=sk-ant-...

# Signing key for session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-deploying

# ---- Organization / escalation fallback ----
# These are shown VERBATIM whenever the assistant cannot answer from the
# documents. Fill in Bald Ridge Lodge's real numbers before going live —
# they ship blank on purpose so nobody is ever given a wrong number.
ORG_NAME=Bald Ridge Lodge
ORG_PHONE=
ORG_EMAIL=
ORG_FALLBACK_CONTACT_NAME=the front office
# Who is asking. Used ONLY to catch scope mismatches (e.g. a regulation that
# covers several provider types). Never a source of answers. Leave blank to skip.
ORG_PROFILE=

# ---- Model ----
ASSISTANT_MODEL=claude-opus-5
ASSISTANT_EFFORT=medium
ASSISTANT_MAX_TOKENS=8192

# ---- Retrieval ----
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=30
# Below this match score (0..1) the assistant refuses to answer and escalates
# instead. Raise it if staff report confident-but-wrong answers; lower it if the
# assistant escalates on questions the documents clearly cover.
RETRIEVAL_MIN_SCORE=0.03
CHUNK_TOKENS=350
CHUNK_OVERLAP=60

# ---- Security ----
SESSION_TTL_MINUTES=480
REQUIRE_2FA=true
MAX_QUERIES_PER_HOUR=60
MAX_UPLOAD_MB=25
# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# ---- Storage ----
DATABASE_URL=sqlite:///./data/baldridge.db
STORAGE_DIR=./storage

# Accounts that sign in with password only (comma-separated).
# Everyone NOT listed here must still enrol in two-factor.
TWOFA_EXEMPT_EMAILS=
